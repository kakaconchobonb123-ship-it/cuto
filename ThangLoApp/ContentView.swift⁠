import SwiftUI

struct ContentView: View {
    @AppStorage("keyExpirationTimestamp") private var keyExpirationTimestamp: Double = 0
    @State private var isUnlocked: Bool = false

    var body: some View {
        Group {
            if isUnlocked && Date().timeIntervalSince1970 < keyExpirationTimestamp {
                MainScriptMenuView(isUnlocked: $isUnlocked, expirationTimestamp: keyExpirationTimestamp)
            } else {
                KeySystemView(isUnlocked: $isUnlocked, expirationTimestamp: $keyExpirationTimestamp)
            }
        }
        .onAppear {
            if Date().timeIntervalSince1970 < keyExpirationTimestamp {
                isUnlocked = true
            } else {
                isUnlocked = false
            }
        }
    }
}

struct KeySystemView: View {
    @Binding var isUnlocked: Bool
    @Binding var expirationTimestamp: Double
    
    @State private var inputKey: String = ""
    @State private var statusMessage: String = "Vui lòng lấy Key để sử dụng App trong 24 giờ."
    @State private var statusColor: Color = .gray
    
    let getKeyURL = "https://www.google.com" 
    
    var todayValidKey: String {
        let formatter = DateFormatter()
        formatter.dateFormat = "ddMMyyyy"
        return "THANG_LO_\(formatter.string(from: Date()))"
    }

    var body: some View {
        ZStack {
            Color(red: 0.08, green: 0.08, blue: 0.11).edgesIgnoringSafeArea(.all)
            
            VStack(spacing: 22) {
                Text("THẮNG LO")
                    .font(.system(size: 36, weight: .black))
                    .foregroundColor(.cyan)
                
                Text("KEY")
                    .font(.system(size: 20, weight: .bold))
                    .foregroundColor(.white)
                    .padding(.bottom, 10)
                
                VStack(alignment: .leading, spacing: 8) {
                    Text("Nhập Key vào:")
                        .font(.caption)
                        .foregroundColor(.gray)
                    
                    TextField("Dán Key lấy từ Web vào đây...", text: $inputKey)
                        .padding()
                        .background(Color(white: 0.15))
                        .cornerRadius(10)
                        .foregroundColor(.white)
                        .autocapitalization(.none)
                        .disableAutocorrection(true)
                }
                .padding(.horizontal, 30)
                
                Button(action: {
                    if let url = URL(string: getKeyURL) {
                        UIApplication.shared.open(url)
                        statusMessage = "Đã mở Web giải đố. Hãy giải đố để lấy Key!"
                        statusColor = .yellow
                    }
                }) {
                    HStack {
                        Image(systemName: "safari")
                        Text("LẤY KEY (GIẢI ĐỐ WEBS)")
                    }
                    .font(.system(size: 14, weight: .bold))
                    .frame(maxWidth: .infinity)
                    .frame(height: 50)
                    .background(Color.blue)
                    .foregroundColor(.white)
                    .cornerRadius(10)
                }
                .padding(.horizontal, 30)
                
                Button(action: {
                    verifyKey()
                }) {
                    HStack {
                        Image(systemName: "key.fill")
                        Text("XÁC NHẬN KEY")
                    }
                    .font(.system(size: 14, weight: .bold))
                    .frame(maxWidth: .infinity)
                    .frame(height: 50)
                    .background(Color.green)
                    .foregroundColor(.white)
                    .cornerRadius(10)
                }
                .padding(.horizontal, 30)
                
                Text(statusMessage)
                    .font(.footnote)
                    .foregroundColor(statusColor)
                    .multilineTextAlignment(.center)
                    .padding(.horizontal, 30)
            }
        }
    }
    
    func verifyKey() {
        if inputKey.trimmingCharacters(in: .whitespacesAndNewlines) == todayValidKey {
            let expireTime = Date().timeIntervalSince1970 + 86400
            expirationTimestamp = expireTime
            
            statusMessage = "Xác thực thành công! Mở Menu..."
            statusColor = .green
            
            DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) {
                withAnimation {
                    isUnlocked = true
                }
            }
        } else {
            statusMessage = "Key chưa đúng hoặc chưa giải xong đố!"
            statusColor = .red
        }
    }
}

struct MainScriptMenuView: View {
    @Binding var isUnlocked: Bool
    var expirationTimestamp: Double
    
    @State private var timeRemainingString: String = ""
    @State private var timer = Timer.publish(every: 1, on: .main, in: .common).autoconnect()
    
    let scriptList = [
        ("Blox Fruits", "loadstring(game:HttpGet('https://raw.githubusercontent.com/scriptpastebin/raw/main/bloxfruits'))()"),
        ("King Legacy", "loadstring(game:HttpGet('https://raw.githubusercontent.com/scriptpastebin/raw/main/kinglegacy'))()"),
        ("Blade Ball", "loadstring(game:HttpGet('https://raw.githubusercontent.com/scriptpastebin/raw/main/bladeball'))()"),
        ("Brookhaven RP", "loadstring(game:HttpGet('https://raw.githubusercontent.com/scriptpastebin/raw/main/brookhaven'))()")
    ]
    
    var body: some View {
        NavigationView {
            ZStack {
                Color(red: 0.08, green: 0.08, blue: 0.11).edgesIgnoringSafeArea(.all)
                
                VStack {
                    HStack {
                        Image(systemName: "timer")
                        Text("Thời gian Key còn lại: \(timeRemainingString)")
                    }
                    .font(.system(size: 13, weight: .semibold))
                    .foregroundColor(.yellow)
                    .padding(8)
                    .frame(maxWidth: .infinity)
                    .background(Color.yellow.opacity(0.15))
                    
                    ScrollView {
                        VStack(spacing: 12) {
                            ForEach(scriptList, id: \.0) { item in
                                ScriptItemRow(gameTitle: item.0, scriptCode: item.1)
                            }
                        }
                        .padding()
                    }
                }
            }
            .navigationTitle("THẮNG LO SCRIPT HUB")
            .navigationBarTitleDisplayMode(.inline)
        }
        .onReceive(timer) { _ in
            updateTimeRemaining()
        }
    }
    
    func updateTimeRemaining() {
        let now = Date().timeIntervalSince1970
        let remaining = expirationTimestamp - now
        
        if remaining <= 0 {
            isUnlocked = false
        } else {
            let hours = Int(remaining) / 3600
            let minutes = (Int(remaining) % 3600) / 60
            let seconds = Int(remaining) % 60
            timeRemainingString = String(format: "%02dh %02dm %02ds", hours, minutes, seconds)
        }
    }
}

struct ScriptItemRow: View {
    var gameTitle: String
    var scriptCode: String
    
    @State private var showConfirmDialog = false
    @State private var isCopied = false
    
    var body: some View {
        HStack {
            VStack(alignment: .leading, spacing: 4) {
                Text(gameTitle)
                    .font(.headline)
                    .foregroundColor(.white)
                Text("Nhấn/Giữ mạnh để Sao Chép")
                    .font(.caption2)
                    .foregroundColor(.gray)
            }
            Spacer()
            Button(action: { showConfirmDialog = true }) {
                Text(isCopied ? "ĐÃ CHÉP!" : "LẤY SCRIPT")
                    .font(.system(size: 12, weight: .bold))
                    .padding(.horizontal, 14)
                    .padding(.vertical, 8)
                    .background(isCopied ? Color.gray : Color.green)
                    .foregroundColor(.white)
                    .cornerRadius(8)
            }
        }
        .padding()
        .background(Color(white: 0.14))
        .cornerRadius(10)
        .onLongPressGesture { showConfirmDialog = true }
        .alert(isPresented: $showConfirmDialog) {
            Alert(
                title: Text("Xác nhận Sao Chép"),
                message: Text("Bạn có muốn sao chép Script cho game \(gameTitle)?"),
                primaryButton: .default(Text("SAO CHÉP"), action: {
                    UIPasteboard.general.string = scriptCode
                    isCopied = true
                    DispatchQueue.main.asyncAfter(deadline: .now() + 3) { isCopied = false }
                }),
                secondaryButton: .cancel(Text("ĐỒNG"))
            )
        }
    }
}
